@{
    ViewData["Title"] = "Jassn Fashion";
}

<!-- HERO SECTION -->
<section class="hero" id="home">

    <div class="hero-content">

        <div class="brand-label">
            ✦ THE ART OF INDIAN FASHION ✦
        </div>

        <p class="welcome-text">
            WELCOME TO
            <strong>JASSN FASHION</strong>
        </p>

        <h1>
            Elegance in
            <br />
            Every <span>Stitch.</span>
        </h1>

        <p class="description">
            Discover the beauty of timeless Indian fashion.
            From elegant one piece dresses to traditional
            Navratri styles, mirror work and beautiful
            handcrafted embroidery.
        </p>

        <a href="#collection" class="main-btn">
            DISCOVER OUR COLLECTION <span>→</span>
        </a>

        <div class="hero-note">
            <span>✦</span> Made with passion, designed with love.
        </div>

    </div>

    <div class="hero-image">

        <img src="/images/dress1.jpg"
             alt="Jassn Fashion Designer Collection" />

        <div class="image-caption">
            <span>JASSN FASHION</span>
            <small>TIMELESS BEAUTY</small>
        </div>

    </div>

</section>


<!-- COLLECTION SECTION -->
<section class="collection" id="collection">

    <div class="section-heading">

        <p>✦ OUR EXCLUSIVE DESIGNS ✦</p>

        <h2>
            Explore Our
            <span>Collections</span>
        </h2>

        <div class="heading-line"></div>

        <span>
            Discover styles that celebrate beauty,
            culture and creativity.
        </span>

    </div>

    <div class="product-grid">

        <div class="product-card">

            <div class="product-image">
                <img src="/images/dress1.jpg"
                     alt="One Piece Collection" />
                <span class="product-number">01</span>
            </div>

            <div class="product-info">
                <h3>One Piece Collection</h3>
                <p>Elegance for Every Occasion</p>
                <a href="#contact">EXPLORE MORE →</a>
            </div>

        </div>


        <div class="product-card">

            <div class="product-image">
                <img src="/images/dress2.jpg"
                     alt="Navratri Collection" />
                <span class="product-number">02</span>
            </div>

            <div class="product-info">
                <h3>Navratri Collection</h3>
                <p>Celebrate Tradition in Style</p>
                <a href="#contact">EXPLORE MORE →</a>
            </div>

        </div>


        <div class="product-card">

            <div class="product-image">
                <img src="/images/dress3.jpg"
                     alt="Classic Mirror Work" />
                <span class="product-number">03</span>
            </div>

            <div class="product-info">
                <h3>Classic Mirror Work</h3>
                <p>Tradition with a Modern Touch</p>
                <a href="#contact">EXPLORE MORE →</a>
            </div>

        </div>


        <div class="product-card">

            <div class="product-image">
                <img src="/images/dress4.jpg"
                     alt="Embroidery Collection" />
                <span class="product-number">04</span>
            </div>

            <div class="product-info">
                <h3>Embroidery Collection</h3>
                <p>Beautifully Crafted Details</p>
                <a href="#contact">EXPLORE MORE →</a>
            </div>

        </div>

    </div>

</section>


<!-- ABOUT SECTION -->
<section class="about" id="about">

    <div class="about-image">

        <img src="/images/dress3.jpg"
             alt="Jassn Fashion Traditional Design" />

        <div class="about-image-tag">
            <span>✦</span>
            THE BEAUTY OF TRADITION
        </div>

    </div>

    <div class="about-content">

        <p class="about-label">
            ✦ A LITTLE ABOUT US ✦
        </p>

        <h2>
            Fashion Made
            <br />
            With <span>Love.</span>
        </h2>

        <div class="heading-line"></div>

        <p class="about-description">
            At Jassn Fashion, every design tells a story
            of beauty, creativity and tradition.
        </p>

        <p class="about-description">
            We bring together elegant one piece styles,
            vibrant Navratri outfits, classic mirror work
            and delicate embroidery to create fashion
            that makes every moment special.
        </p>

        <p class="about-quote">
            "Your Style, Our Passion, Your Beautiful Story."
        </p>

        <a href="#contact" class="main-btn">
            GET IN TOUCH →
        </a>

    </div>

</section>


<!-- CONTACT SECTION -->
<section class="contact" id="contact">

    <div class="contact-inner">

        <p class="contact-label">
            ✦ WE WOULD LOVE TO HEAR FROM YOU ✦
        </p>

        <h2>
            Let's Create
            <br />
            Something <span>Beautiful.</span>
        </h2>

        <p>
            Found a design you love?
            Connect with Jassn Fashion and
            explore your favourite collection.
        </p>

        <!-- WHATSAPP CONTACT BUTTON -->

        <a href="https://api.whatsapp.com/send?phone=916353063208&text=Welcome%20to%20Jassn%20Fashion!%20I%20am%20interested%20in%20your%20collection."
           target="_blank"
           rel="noopener noreferrer"
           class="whatsapp-btn">

            <span class="whatsapp-icon">✆</span>

            <span>
                <strong>CHAT WITH US</strong>
                <small>Connect with us on WhatsApp</small>
            </span>

            <span class="button-arrow">→</span>

        </a>

    </div>

</section>


<!-- FOOTER -->
<footer class="fashion-footer">

    <h2>
        JASSN <span>FASHION</span>
    </h2>

    <p>Elegance • Style • Tradition</p>

    <div class="footer-line"></div>

    <p class="footer-bottom">
        Designed with love for fashion.
    </p>

</footer>


<!-- FLOATING WHATSAPP BUTTON -->

<a href="https://api.whatsapp.com/send?phone=916353063208&text=Welcome%20to%20Jassn%20Fashion!"
   target="_blank"
   rel="noopener noreferrer"
   class="floating-whatsapp"
   aria-label="Chat with Jassn Fashion on WhatsApp">

    <span>✆</span>

    <strong>WhatsApp</strong>

</a>
